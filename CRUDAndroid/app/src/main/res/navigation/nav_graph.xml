<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/albumListFragment">

    <fragment
        android:id="@+id/albumListFragment"
        android:name="com.christian.crudandroid.ui.fragments.AlbumListFragment"
        android:label="Album List">
        <action
            android:id="@+id/action_albumListFragment_to_addAlbumFragment"
            app:destination="@id/addAlbumFragment" />
        <action
            android:id="@+id/action_albumListFragment_to_editAlbumFragment"
            app:destination="@id/editAlbumFragment">
            <argument
                android:name="album"
                app:argType="com.christian.crudandroid.models.Album" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/addAlbumFragment"
        android:name="com.christian.crudandroid.ui.fragments.AddAlbumFragment"
        android:label="Add Album"
        tools:layout="@layout/fragment_add_album" >
        <action
            android:id="@+id/action_addAlbumFragment_to_albumListFragment"
            app:destination="@id/albumListFragment" />
    </fragment>

    <fragment
        android:id="@+id/editAlbumFragment"
        android:name="com.christian.crudandroid.ui.fragments.EditAlbumFragment"
        tools:layout="@layout/fragment_edit_album">
        <argument
            android:name="album"
            app:argType="com.christian.crudandroid.models.Album" />
        <action
            android:id="@+id/action_editAlbumFragment_to_albumListFragment"
            app:destination="@id/albumListFragment" />
    </fragment>
</navigation>
